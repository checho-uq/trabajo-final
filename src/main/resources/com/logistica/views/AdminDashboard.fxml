<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.logistica.viewController.AdminDashboardController"
            stylesheets="@../css/styles.css">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="toolbar">
            <Label text="⚙️ BookIt Admin" styleClass="label-title" style="-fx-font-size: 20;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Reporte Ejecutivo" onAction="#generarReporteEjecutivo" styleClass="btn-primary" style="-fx-background-color: #2ea043;"/>
            <Button text="Reporte PDF" onAction="#generarPDF" styleClass="btn-warn"/>
            <Button text="Reporte CSV" onAction="#generarCSV" styleClass="btn-warn"/>
            <Button text="Cerrar Sesión" onAction="#logout" styleClass="button"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <!-- TAB: EVENTOS -->
            <Tab text="Eventos">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <!-- Formulario Crear/Editar Evento -->
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="txtEvNombre" promptText="Nombre evento" prefWidth="160"/>
                        <TextField fx:id="txtEvCategoria" promptText="Categoría" prefWidth="110"/>
                        <TextField fx:id="txtEvCiudad" promptText="Ciudad" prefWidth="100"/>
                        <DatePicker fx:id="dpEvFecha" promptText="Fecha" prefWidth="130"/>
                        <ComboBox fx:id="cmbEvRecinto" promptText="Recinto" prefWidth="150"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="txtEvDescripcion" promptText="Descripción" prefWidth="300" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtEvPolCancel" promptText="Política cancelación" prefWidth="180"/>
                        <TextField fx:id="txtEvPolReembolso" promptText="Política reembolso" prefWidth="180"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button text="+ Crear" onAction="#crearEvento" styleClass="btn-primary"/>
                        <Button text="✏ Actualizar" onAction="#actualizarEvento" styleClass="btn-warn"/>
                        <Button text="Publicar" onAction="#publicarEvento" styleClass="btn-success"/>
                        <Button text="Pausar" onAction="#pausarEvento" styleClass="btn-warn"/>
                        <Button text="Cancelar" onAction="#cancelarEvento" styleClass="btn-danger"/>
                        <Button text="Eliminar" onAction="#eliminarEvento" styleClass="btn-danger"/>
                    </HBox>
                    <TableView fx:id="tblEventos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colEvId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colEvNombre" text="Nombre" prefWidth="180"/>
                            <TableColumn fx:id="colEvCategoria" text="Categoría" prefWidth="100"/>
                            <TableColumn fx:id="colEvCiudad" text="Ciudad" prefWidth="100"/>
                            <TableColumn fx:id="colEvFecha" text="Fecha" prefWidth="120"/>
                            <TableColumn fx:id="colEvEstado" text="Estado" prefWidth="100"/>
                            <TableColumn fx:id="colEvRecinto" text="Recinto" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <!-- TAB: USUARIOS -->
            <Tab text="Usuarios">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="txtUsNombre" promptText="Nombre completo" prefWidth="170"/>
                        <TextField fx:id="txtUsEmail" promptText="Email" prefWidth="170"/>
                        <TextField fx:id="txtUsTel" promptText="Teléfono" prefWidth="120"/>
                        <PasswordField fx:id="txtUsPassword" promptText="Contraseña" prefWidth="120"/>
                        <CheckBox fx:id="chkUsAdmin" text="Admin"/>
                    </HBox>
                    <HBox spacing="8">
                        <Button text="+ Crear Usuario" onAction="#crearUsuario" styleClass="btn-primary"/>
                        <Button text="✏ Actualizar" onAction="#actualizarUsuario" styleClass="btn-warn"/>
                        <Button text="Eliminar Usuario" onAction="#eliminarUsuario" styleClass="btn-danger"/>
                    </HBox>
                    <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colUsId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colUsNombre" text="Nombre" prefWidth="180"/>
                            <TableColumn fx:id="colUsEmail" text="Email" prefWidth="200"/>
                            <TableColumn fx:id="colUsTel" text="Teléfono" prefWidth="120"/>
                            <TableColumn fx:id="colUsRol" text="Rol" prefWidth="80"/>
                            <TableColumn fx:id="colUsCompras" text="Compras" prefWidth="80"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <!-- TAB: COMPRAS -->
            <Tab text="Compras">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <HBox spacing="8">
                        <Button text="Cancelar Compra" onAction="#cancelarCompraAdmin" styleClass="btn-danger"/>
                        <Button text="Registrar Reembolso" onAction="#registrarReembolso" styleClass="btn-warn"/>
                    </HBox>
                    <TableView fx:id="tblCompras" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCmpId" text="ID" prefWidth="140"/>
                            <TableColumn fx:id="colCmpCliente" text="Cliente" prefWidth="150"/>
                            <TableColumn fx:id="colCmpEvento" text="Evento" prefWidth="170"/>
                            <TableColumn fx:id="colCmpTotal" text="Total" prefWidth="100"/>
                            <TableColumn fx:id="colCmpEstado" text="Estado" prefWidth="100"/>
                            <TableColumn fx:id="colCmpFecha" text="Fecha" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <!-- TAB: RECINTOS -->
            <Tab text="Recintos">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="txtRecNombre" promptText="Nombre recinto" prefWidth="170"/>
                        <TextField fx:id="txtRecDir" promptText="Dirección" prefWidth="200"/>
                        <TextField fx:id="txtRecCiudad" promptText="Ciudad" prefWidth="130"/>
                    </HBox>
                    <HBox spacing="8">
                        <Button text="+ Crear Recinto" onAction="#crearRecintoAction" styleClass="btn-primary"/>
                        <Button text="✏ Actualizar" onAction="#actualizarRecintoAction" styleClass="btn-warn"/>
                        <Button text="Eliminar" onAction="#eliminarRecintoAction" styleClass="btn-danger"/>
                    </HBox>
                    <TableView fx:id="tblRecintos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colRecId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colRecNombre" text="Nombre" prefWidth="200"/>
                            <TableColumn fx:id="colRecCiudad" text="Ciudad" prefWidth="120"/>
                            <TableColumn fx:id="colRecDir" text="Dirección" prefWidth="200"/>
                            <TableColumn fx:id="colRecZonas" text="Zonas" prefWidth="80"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <!-- TAB: ZONAS -->
            <Tab text="Zonas">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Recinto:" styleClass="label-muted"/>
                        <ComboBox fx:id="cmbZonaRecinto" promptText="Seleccionar recinto" prefWidth="200"/>
                        <TextField fx:id="txtZonaNombre" promptText="Nombre zona" prefWidth="140"/>
                        <TextField fx:id="txtZonaCapacidad" promptText="Capacidad" prefWidth="90"/>
                        <TextField fx:id="txtZonaPrecio" promptText="Precio base" prefWidth="100"/>
                    </HBox>
                    <HBox spacing="8">
                        <Button text="+ Crear Zona" onAction="#crearZonaAction" styleClass="btn-primary"/>
                        <Button text="✏ Actualizar" onAction="#actualizarZonaAction" styleClass="btn-warn"/>
                        <Button text="Eliminar" onAction="#eliminarZonaAction" styleClass="btn-danger"/>
                    </HBox>
                    <TableView fx:id="tblZonas" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colZonaId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colZonaNombre" text="Nombre" prefWidth="160"/>
                            <TableColumn fx:id="colZonaCapacidad" text="Capacidad" prefWidth="90"/>
                            <TableColumn fx:id="colZonaPrecio" text="Precio Base" prefWidth="100"/>
                            <TableColumn fx:id="colZonaRecinto" text="Recinto" prefWidth="160"/>
                            <TableColumn fx:id="colZonaAsientos" text="Asientos" prefWidth="80"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <!-- TAB: ASIENTOS -->
            <Tab text="Asientos">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Recinto:" styleClass="label-muted"/>
                        <ComboBox fx:id="cmbAsientoRecinto" promptText="Seleccionar recinto" prefWidth="200" onAction="#cargarZonasAsiento"/>
                        <Label text="Zona:" styleClass="label-muted"/>
                        <ComboBox fx:id="cmbAsientoZona" promptText="Seleccionar zona" prefWidth="200" onAction="#cargarAsientosAdmin"/>
                    </HBox>
                    <HBox spacing="8">
                        <Button text="✅ Habilitar" onAction="#habilitarAsiento" styleClass="btn-success"/>
                        <Button text="🚫 Bloquear" onAction="#bloquearAsiento" styleClass="btn-danger"/>
                        <Button text="🔓 Liberar" onAction="#liberarAsiento" styleClass="btn-warn"/>
                    </HBox>
                    <TableView fx:id="tblAsientos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colAsId" text="ID" prefWidth="100"/>
                            <TableColumn fx:id="colAsFila" text="Fila" prefWidth="80"/>
                            <TableColumn fx:id="colAsNumero" text="Número" prefWidth="80"/>
                            <TableColumn fx:id="colAsEstado" text="Estado" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <!-- TAB: MÉTRICAS -->
            <Tab text="Métricas">
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                    <VBox spacing="12" style="-fx-padding: 10;">
                        <!-- Cards métricas -->
                        <HBox spacing="12">
                            <VBox styleClass="card" prefWidth="170" alignment="CENTER">
                                <padding><Insets top="14" bottom="14" left="14" right="14"/></padding>
                                <Label text="Total Compras" styleClass="label-muted"/>
                                <Label fx:id="lblTotalCompras" styleClass="label-price" style="-fx-font-size: 28;"/>
                            </VBox>
                            <VBox styleClass="card" prefWidth="170" alignment="CENTER">
                                <padding><Insets top="14" bottom="14" left="14" right="14"/></padding>
                                <Label text="Total Ingresos" styleClass="label-muted"/>
                                <Label fx:id="lblTotalIngresos" styleClass="label-price" style="-fx-font-size: 22;"/>
                            </VBox>
                            <VBox styleClass="card" prefWidth="170" alignment="CENTER">
                                <padding><Insets top="14" bottom="14" left="14" right="14"/></padding>
                                <Label text="Tasa Cancelación" styleClass="label-muted"/>
                                <Label fx:id="lblTasaCancelacion" style="-fx-font-size: 28; -fx-text-fill: #f85149; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox styleClass="card" prefWidth="170" alignment="CENTER">
                                <padding><Insets top="14" bottom="14" left="14" right="14"/></padding>
                                <Label text="Total Eventos" styleClass="label-muted"/>
                                <Label fx:id="lblTotalEventos" styleClass="label-price" style="-fx-font-size: 28;"/>
                            </VBox>
                            <VBox styleClass="card" prefWidth="190" alignment="CENTER">
                                <padding><Insets top="14" bottom="14" left="14" right="14"/></padding>
                                <Label text="Servicios Adicionales" styleClass="label-muted"/>
                                <Label fx:id="lblTotalServicios" styleClass="label-price" style="-fx-font-size: 22;"/>
                            </VBox>
                        </HBox>
                        <!-- Selección de evento para gráficas -->
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Evento:" styleClass="label-section"/>
                            <ComboBox fx:id="cmbMetricaEvento" promptText="Seleccionar evento" prefWidth="300" onAction="#cambiarEventoMetrica"/>
                        </HBox>
                        <!-- Botones toggle para gráficas -->
                        <HBox spacing="8">
                            <Button text="📊 Ventas por Evento" onAction="#mostrarGraficaVentas" styleClass="btn-primary"/>
                            <Button text="🥧 Ocupación por Zona" onAction="#mostrarGraficaOcupacion" styleClass="btn-success"/>
                            <Button text="💰 Ingresos Servicios" onAction="#mostrarGraficaServicios" styleClass="btn-warn"/>
                            <Button text="🏆 Top Eventos" onAction="#mostrarGraficaTop" styleClass="btn-primary"/>
                            <Button text="❌ Tasa Cancelación" onAction="#mostrarGraficaCancelacion" styleClass="btn-danger"/>
                            <Button text="📈 Línea Ventas" onAction="#mostrarGraficaLinea" styleClass="btn-primary"/>
                        </HBox>
                        <!-- Zona de gráficas intercambiables -->
                        <StackPane fx:id="panelGraficas" prefHeight="320" style="-fx-background-color: transparent;">
                            <BarChart fx:id="chartVentas" prefWidth="800" prefHeight="300">
                                <xAxis><CategoryAxis label="Evento"/></xAxis>
                                <yAxis><NumberAxis label="Ventas ($)"/></yAxis>
                            </BarChart>
                        </StackPane>
                        <!-- Top Eventos Ranking -->
                        <HBox spacing="16" VBox.vgrow="SOMETIMES">
                            <VBox spacing="4" prefWidth="350">
                                <Label text="🏆 Ranking Top Eventos" styleClass="label-section"/>
                                <ListView fx:id="lstTopEventos" prefHeight="120"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="📋 Incidencias Recientes" styleClass="label-section"/>
                                <HBox spacing="4">
                                    <DatePicker fx:id="dpIncidenciaInicio" promptText="Fecha inicio" prefWidth="130"/>
                                    <DatePicker fx:id="dpIncidenciaFin" promptText="Fecha fin" prefWidth="130"/>
                                    <TextField fx:id="txtFiltroTipoIncidencia" promptText="Tipo" prefWidth="120"/>
                                    <Button text="Filtrar" onAction="#filtrarIncidencias" styleClass="btn-primary"/>
                                    <Button text="Limpiar" onAction="#limpiarFiltroIncidencias" styleClass="btn-warn"/>
                                </HBox>
                                <ListView fx:id="lstIncidencias" prefHeight="120"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
