@startuml
' TicketHub - Diagrama de Clases Completo
' RF-044: Diagrama con relaciones, multiplicidad, roles, jerarquías, atributos y estética
' Versión: 2.0 - Todas las clases, patrones y relaciones incluidas

skinparam backgroundColor #0D1117
skinparam defaultFontName Consolas
skinparam defaultFontSize 11
skinparam defaultTextColor #C9D1D9

skinparam class {
  BorderColor #30363D
  BackgroundColor #161B22
  FontColor #C9D1D9
  HeaderBackgroundColor #1F2937
  ArrowColor #58A6FF
}

skinparam interface {
  BorderColor #58A6FF
  BackgroundColor #0D2F53
  FontColor #58A6FF
  ArrowColor #58A6FF
}

skinparam enum {
  BorderColor #D2A8FF
  BackgroundColor #2D1B4E
  FontColor #D2A8FF
  ArrowColor #D2A8FF
}

skinparam package {
  BorderColor #30363D
  BackgroundColor #0D1117
  FontColor #8B949E
}

skinparam arrow {
  Color #58A6FF
  FontColor #8B949E
}

skinparam note {
  BackgroundColor #1F2937
  BorderColor #30363D
  FontColor #C9D1D9
}

legend top right
  <color:#58A6FF><b>TicketHub</b></color> — Diagrama de Clases
  <color:#8B949E>Relaciones:</color>
  <#58A6FF>───></color> Asociación
  <#58A6FF>──*></color> Composición
  <#58A6FF>──|></color> Herencia
  <#58A6FF>..|></color> Implementación
  <#58A6FF>..></color> Dependencia
endlegend

' ===================================================================
'  PAQUETE: MODELO PRINCIPAL (Dominio)
' ===================================================================
package "Modelo Principal (Dominio)" as DOMAIN #0D1117 {

  ' --- Usuario & Observer ---
  class Usuario as "Usuario\n(Observer)" #161B22 {
    <color:#58A6FF>- idUsuario: String
    <color:#58A6FF>- nombreCompleto: String
    <color:#58A6FF>- email: String
    <color:#58A6FF>- telefono: String
    <color:#58A6FF>- password: String
    <color:#58A6FF>- esAdmin: boolean
    <color:#58A6FF>- metodosPago: List<MetodoPago>
    <color:#58A6FF>- historialCompras: List<Compra>
    <color:#58A6FF>- notificacionesPendientes: List<String>
    --
    <color:#3FB950>+ actualizar(mensaje: String): void
    <color:#3FB950>+ gestionarPerfil(): void
    <color:#3FB950>+ gestionarMetodosPago(): void
    <color:#3FB950>+ consultarComprasAsociadas(): void
    <color:#3FB950>+ getNotificacionesPendientes(): List<String>
    <color:#3FB950>+ limpiarNotificaciones(): void
  }

  note right of Usuario
    <b>Patrón OBSERVER — Estructura Completa</b>
    ┌──────────────────────────────────────┐
    │ <b>Subject: Evento</b>                   │
    │ - observadores: List&lt;Usuario&gt;       │
    │ + agregarObservador(u)               │
    │ + notificar(mensaje)                 │
    ├──────────────────────────────────────┤
    │ <b>Observer: Usuario</b>                 │
    │ + actualizar(mensaje)                │
    │ - notificacionesPendientes           │
    │ + getNotificacionesPendientes()      │
    └──────────────────────────────────────┘
  <color:#8B949E>Evento notifica → Usuario recibe
  cuando cambia estado del evento.</color>
  end note

  class MetodoPago #161B22 {
    <color:#58A6FF>- tipo: String
    <color:#58A6FF>- detalle: String
  }

  ' --- Evento & Subject ---
  class Evento as "Evento\n(Subject)" #161B22 {
    <color:#58A6FF>- idEvento: String
    <color:#58A6FF>- nombre: String
    <color:#58A6FF>- categoria: String
    <color:#58A6FF>- descripcion: String
    <color:#58A6FF>- ciudad: String
    <color:#58A6FF>- fecha: LocalDateTime
    <color:#58A6FF>- estado: EstadoEvento
    <color:#58A6FF>- recintoAsociado: Recinto
    <color:#58A6FF>- politicas: PoliticasEvento
    <color:#58A6FF>- observadores: List<Usuario>
    --
    <color:#3FB950>+ agregarObservador(u: Usuario): void
    <color:#3FB950>+ notificar(mensaje: String): void
    <color:#3FB950>+ publicar(): void
    <color:#3FB950>+ pausar(): void
    <color:#3FB950>+ cancelar(): void
    <color:#3FB950>+ consultarDisponibilidad(): Map<Zona, Integer>
    <color:#3FB950>+ getEstado(): EstadoEvento
  }

  note right of Evento : <b>Observer</b> — Sujeto que notifica

  enum EstadoEvento #2D1B4E {
    <color:#D2A8FF>BORRADOR
    <color:#D2A8FF>PUBLICADO
    <color:#D2A8FF>PAUSADO
    <color:#D2A8FF>CANCELADO
    <color:#D2A8FF>FINALIZADO
  }

  class PoliticasEvento #161B22 {
    <color:#58A6FF>- politicaCancelacion: String
    <color:#58A6FF>- politicaReembolso: String
  }

  ' --- Recinto, Zona, Asiento ---
  class Recinto #161B22 {
    <color:#58A6FF>- idRecinto: String
