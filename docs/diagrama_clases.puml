    ┌────────────────────────────────┐
    │ <b>Creator: IEntradaFactory</b>    │
    │ + crearEntrada(z, a): Entrada  │
    ├────────────────────────────────┤
    │ <b>Concrete: EntradaNumeradaFactory</b>│
    │ genera IDs con AtomicLong      │
    ├────────────────────────────────┤
    │ <b>Producto: Entrada</b>           │
    │ creado por la fábrica          │
    └────────────────────────────────┘
  end note

  class EntradaNumeradaFactory #1F2937 {
