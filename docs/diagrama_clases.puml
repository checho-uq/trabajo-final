    <color:#58A6FF>- fecha: LocalDateTime
    <color:#58A6FF>- entidadAfectada: String
    --
    <color:#3FB950>+ registrar(): void
  }

  class Filtros #161B22 {
    <color:#58A6FF>- fecha: String
    <color:#58A6FF>- ciudad: String
    <color:#58A6FF>- categoria: String
    <color:#58A6FF>- precioMax: double
    <color:#58A6FF>- estado: String
    <color:#58A6FF>- fechaInicio: LocalDate
    <color:#58A6FF>- fechaFin: LocalDate
    --
    <color:#3FB950>+ getCiudad(): String
    <color:#3FB950>+ setCiudad(c: String): void
    <color:#3FB950>+ getCategoria(): String
    <color:#3FB950>+ setCategoria(c: String): void
    <color:#3FB950>+ getFechaInicio(): LocalDate
    <color:#3FB950>+ setFechaInicio(f: LocalDate): void
    <color:#3FB950>+ getFechaFin(): LocalDate
    <color:#3FB950>+ setFechaFin(f: LocalDate): void
    <color:#3FB950>+ getPrecioMax(): double
    <color:#3FB950>+ setPrecioMax(p: double): void
    <color:#3FB950>+ getEstado(): String
    <color:#3FB950>+ setEstado(e: String): void
  }
}

