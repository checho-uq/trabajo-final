}

skinparam interface {
  BorderColor #58A6FF
  BackgroundColor #0D2F53
  FontColor #58A6FF
  ArrowColor #58A6FF
}

skinparam enum {
  BorderColor #D2A8FF
  BackgroundColor #2D1B4E
  FontColor #D2A8FF
