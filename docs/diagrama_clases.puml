    <color:#58A6FF>- zonas: List<Zona>
    --
    <color:#3FB950>+ administrarZonas(z: Zona): void
  }

  class Zona #161B22 {
    <color:#58A6FF>- idZona: String
    <color:#58A6FF>- nombre: String
    <color:#58A6FF>- capacidad: int
    <color:#58A6FF>- precioBase: double
    <color:#58A6FF>- estrategiaTarifa: ITarifaStrategy
    <color:#58A6FF>- asientos: List<Asiento>
    --
    <color:#3FB950>+ consultarOcupacion(): double
    <color:#3FB950>+ calcularPrecioFinal(): double
    <color:#3FB950>+ definirPrecioBase(precio: double): void
    <color:#3FB950>+ definirCapacidad(cap: int): void
    <color:#3FB950>+ setEstrategiaTarifa(estrategia: ITarifaStrategy): void
    <color:#3FB950>+ addAsiento(a: Asiento): void
  }

  note right of Zona
    <b>Patrón STRATEGY — Estructura Completa</b>
    ┌──────────────────────────────────────┐
    │ <b>Context: Zona</b>                     │
    │ - estrategiaTarifa: ITarifaStrategy   │
    │ + calcularPrecioFinal()               │
    ├──────────────────────────────────────┤
    │ <b>Strategy: ITarifaStrategy</b>          │
    │ + calcular(zona): double              │
    ├──────────────────────────────────────┤
    │ <b>Concretas:</b>                        │
    │ TarifaEstandar — precio base          │
    │ TarifaPreventa  — -20% descuento      │
    └──────────────────────────────────────┘
  </color><color:#8B949E>Zona delega cálculo de precio
  en la estrategia inyectada.</color>
  end note

  class Asiento #161B22 {
    <color:#58A6FF>- idAsiento: String
    <color:#58A6FF>- fila: String
    <color:#58A6FF>- numero: String
    <color:#58A6FF>- estado: EstadoAsiento
    --
    <color:#3FB950>+ cambiarEstado(nuevo: EstadoAsiento): void
    <color:#3FB950>+ getFila(): String
    <color:#3FB950>+ getNumero(): String
  }

  enum EstadoAsiento #2D1B4E {
    <color:#D2A8FF>DISPONIBLE
    <color:#D2A8FF>RESERVADO
    <color:#D2A8FF>VENDIDO
    <color:#D2A8FF>BLOQUEADO
  }

  ' --- Compra, Entrada, Incidencia ---
  class Compra as "Compra\n(Context State)" #161B22 {
    <color:#58A6FF>- idCompra: String
    <color:#58A6FF>- usuarioAsociado: Usuario
    <color:#58A6FF>- eventoAsociado: Evento
    <color:#58A6FF>- fechaCreacion: LocalDateTime
    <color:#58A6FF>- total: double
    <color:#58A6FF>- estadoActual: IEstadoCompra
    <color:#58A6FF>- itemsCompra: List<Entrada>
    --
    <color:#3FB950>+ pagar(): void
    <color:#3FB950>+ cancelar(): void
    <color:#3FB950>+ reportarIncidencia(): void
    <color:#3FB950>+ calcularTotal(): void
    <color:#3FB950>+ consultarDetalle(): void
    <color:#3FB950>+ agregarEntrada(e: Entrada): void
    <color:#3FB950>+ setEstado(estado: IEstadoCompra): void
  }

  note right of Compra
    <b>Patrón STATE — Estructura Completa</b>
    ┌──────────────────────────────────────────┐
    │ <b>Context: Compra</b>                       │
    │ - estadoActual: IEstadoCompra             │
    │ + pagar()      → estado.siguiente()       │
    │ + cancelar()   → estado.cancelar()        │
    ├──────────────────────────────────────────┤
    │ <b>State: IEstadoCompra</b>                  │
    │ + siguiente(c)  : transición adelante     │
    │ + cancelar(c)   : transición cancelación  │
    ├──────────────────────────────────────────┤
    │ <b>Concretos:</b>                             │
    │ CompraCreada → CompraPagada → Confirmada  │
    │ CompraIncidencia → Pagada o Cancelada     │
    │ CompraCancelada / Reembolsada (terminal)  │
    └──────────────────────────────────────────┘
  </color><color:#8B949E>Compra delega comportamiento según
  su estado actual. Cada estado concreto
  define las transiciones permitidas.</color>
  end note

  abstract class Entrada as "Entrada\n(Component)" #161B22 {
    <color:#58A6FF># idEntrada: String
    <color:#58A6FF># zona: Zona
    <color:#58A6FF># asiento: Asiento
    <color:#58A6FF># estadoEntrada: EstadoEntrada
    --
    <color:#F0883E>{abstract} + getPrecioFinal(): double
    <color:#3FB950>+ generarComprobante(): void
    <color:#3FB950>+ anular(): void
    <color:#3FB950>+ getCostoServicios(): double
    <color:#3FB950>+ getIdEntrada(): String
    <color:#3FB950>+ getZona(): Zona
    <color:#3FB950>+ getAsiento(): Asiento
    <color:#3FB950>+ setAsiento(a: Asiento): void
  }

  note right of Entrada
    <b>Patrón DECORATOR — Estructura Completa</b>
    ┌──────────────────────────────────────────┐
    │ <b>Component: Entrada</b>                    │
    │ {abstract} + getPrecioFinal(): double     │
    ├──────────────────────────────────────────┤
    │ <b>Decorator: ServicioDecorator</b>          │
    │ - entradaDecorada: Entrada                │
    │ + getCostoAdicional(): double             │
    ├──────────────────────────────────────────┤
    │ <b>Concretos (c/u suma su costo):</b>        │
    │ AccesoVip (+$50K)  SeguroCancel (+$15K)  │
    │ Merchandising (+$25K)  Parquead (+$20K)  │
    │ AccesoPreferencial (+$35K)                │
    └──────────────────────────────────────────┘
  </color><color:#8B949E>Múltiples decoradores se apilan
  sobre EntradaBase para agregar
  servicios sin modificar la clase.</color>
  end note

  class EntradaBase #161B22 {
    <color:#58A6FF>- precioBase: double
    --
    <color:#3FB950>+ getPrecioFinal(): double
  }

  enum EstadoEntrada #2D1B4E {
    <color:#D2A8FF>ACTIVA
    <color:#D2A8FF>USADA
    <color:#D2A8FF>ANULADA
  }

  class Incidencia #161B22 {
    <color:#58A6FF>- idIncidencia: String
    <color:#58A6FF>- tipo: String
